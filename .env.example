# REQUIRED: Supabase -> Project Settings -> API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Server-only secret/service_role key. Never put this in frontend code or a VITE_* variable.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Required for admin panel API actions. Use a long random secret (32+ characters).
ADMIN_SECRET=replace_with_a_long_random_secret

# Optional Telegram bot from @BotFather. Required for signed Telegram user identity and bot entrypoint.
BOT_TOKEN=
BOT_USERNAME=

# Public HTTPS URL of this app, e.g. https://studio.example.com (no trailing slash)
WEBAPP_URL=

# Telegram numeric user/chat ID to receive new order and payment screenshot notifications.
ADMIN_TELEGRAM_ID=
PORT=3000
NODE_ENV=production

# Hosting is manually operated from the admin panel; no external runner URL is required.
